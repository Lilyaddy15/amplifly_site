---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
---

<Layout title="You're on the list" description="Thanks for subscribing to Amplifly updates.">
  <section class="min-h-screen flex items-center justify-center bg-deep-navy text-white py-20 pt-32">
    <div class="container px-6 mx-auto text-center max-w-xl">
      <div class="text-6xl mb-6">🎉</div>
      <h1 class="text-white text-4xl font-bold mb-4">You're on the list.</h1>
      <p class="text-medium-blue text-lg leading-relaxed mb-8">
        Thanks for subscribing. We'll keep you posted on updates and the Android release.
      </p>
      <p class="text-medium-blue/80 text-base leading-relaxed mb-4">
        Amplifly is already live on iOS — grab it now:
      </p>
      <div class="flex justify-center mb-10">
        <AppStoreBadge height="h-14" />
      </div>
      <p class="text-medium-blue/60 text-sm mb-10">
        Questions, or want to share your ND experience to help shape the app? Email us at{' '}
        <a href="mailto:hello@amplifly.me" class="text-bright-blue hover:underline">hello@amplifly.me</a>.
      </p>
      <a href="/"
         class="inline-block border border-medium-blue/40 hover:border-medium-blue text-medium-blue hover:text-white font-semibold px-8 py-4 rounded-xl transition-colors">
        Back to Amplifly
      </a>
    </div>
  </section>
  <Footer />
</Layout>
