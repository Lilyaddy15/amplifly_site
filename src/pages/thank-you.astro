---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import { APP_STORE_NAME } from '../consts';
import { STATES, glyph } from '../lib/states';
---

<Layout title="You're on the list" description="Thanks for subscribing to Amplifly updates.">
  <section class="band ty" data-theme="navy">
    <div class="wrap">
      <div class="ty__glyphs" aria-hidden="true">
        {STATES.map(s => <Fragment set:html={glyph(s.id, 40)} />)}
      </div>
      <p class="eyebrow">Subscribed</p>
      <h1 class="display" style="margin-top:16px">You're on <em>the list.</em></h1>
      <p class="lead" style="margin-top:24px;max-width:40ch">
        Thanks for subscribing. We'll keep you posted on app updates and the Android release, and if
        you asked, we'll tell you the moment the BioProxal wearable ships.
      </p>
      <p class="body" style="margin-top:32px">{APP_STORE_NAME} is already live on iOS:</p>
      <div class="actions" style="margin-top:16px">
        <AppStoreBadge height="h-14" />
        <a class="btn btn--ghost" href="/">Back to Amplifly</a>
      </div>
      <p class="small" style="margin-top:40px;max-width:52ch">
        Questions, or want to share your ND experience to help shape the app? Email
        <a class="link" href="mailto:hello@amplifly.me">hello@amplifly.me</a>.
      </p>
    </div>
  </section>
  <Footer />
</Layout>
