---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import { APP_STORE_NAME } from '../consts';

const supportEmail = 'hello@amplifly.me';

const topics = [
  {
    q: 'Getting started',
    a: 'Create an account or sign in, then tap the brain state that matches how you woke up — Buzzing, Sharp, Flat, Foggy, or Scattered. Amplifly gives you tailored picks for right now — and you can update your state any time it shifts (tap Update on the Today tab). Log a flow session after a work block (it takes about 60 seconds), or run the Focus timer and the log opens with the time already measured. Your operating manual starts filling in from there. No sensors or wearables are required — the version on the App Store today (' + APP_STORE_NAME + ') is software only.',
  },
  {
    q: 'Where do I pair the BioProxal wearable?',
    a: 'Not yet in the App Store version. The BioProxal wearable integration is in development on a separate branch of the app and is not part of ' + APP_STORE_NAME + ', so there is no Device screen and nothing to pair. If you have the App Store build and do not see wearable options, that is expected. The wearable will be optional. Tick "Tell me when the wearable ships" on the email form at amplifly.me and we will let you know.',
  },
  {
    q: 'Do I need an account?',
    a: 'Yes. Amplifly needs an account to get past the sign-in screen — there is no guest mode. Your data is stored on your device and synced to your account, and every algorithm runs on the device, so once you are signed in the app works offline; the account is what keeps your data backed up and available across devices. Signing up takes an email address and a password.',
  },
  {
    q: 'My data isn\'t showing up on a new device',
    a: 'Sign in with the same email on both devices and make sure each has a network connection. Sync runs automatically in the background; give it a few seconds after signing in. Note that signing in with a different account on a device clears that device\'s local data first. If your data still doesn\'t appear, email us and we\'ll help.',
  },
  {
    q: 'The Focus timer isn\'t alerting me for breaks',
    a: 'Break and back-to-work alerts are local notifications, so Amplifly needs notification permission in your device Settings > Notifications to reach you when the app is closed. Breaks are also off by default — turn on "Include breaks" when you set up a session.',
  },
  {
    q: 'I can\'t sign in or forgot my password',
    a: 'On the sign-in screen, tap "Forgot password?" and enter your email. We\'ll send you a reset code — enter it with a new password to get back in. If you don\'t receive the code, check your spam folder, or contact us and we\'ll sort it out.',
  },
  {
    q: 'I\'m not getting reminders / notifications',
    a: 'Reminders are off by default. Turn them on under Profile > Notifications, where you can set a daily check-in time and turn on the "Your flow window is open" reminder, which is timed to your peak flow hour (10 AM until you have logged enough sessions). Also make sure notifications are enabled for Amplifly in your device Settings > Notifications. Reminders are local and optional — the app works fully without them.',
  },
  {
    q: 'How do I delete my data or account?',
    a: `To remove data stored locally, uninstall the app — everything on your device is deleted automatically. Uninstalling does not delete your account, though. To delete your account and all associated data from our servers, email ${supportEmail} with the subject "Delete my account," and we'll remove it within 7 days.`,
  },
  {
    q: 'Is Amplifly a medical or therapy product?',
    a: 'No. Amplifly is a self-understanding and focus tool, not a clinical or diagnostic product. If you need mental health support, please work with a qualified professional.',
  },
];
---

<Layout
  title="Support"
  description="Get help with Amplifly. Contact support, find answers to common questions, and learn how to manage your account and data."
>
  <PageHead eyebrow="Support" title="Stuck? We read" accent="every message." lead="We're a small team. Here's how to get help, and answers to what people ask most." />

  <section class="band band--tight" data-theme="blue">
    <div class="wrap split" style="align-items:end">
      <div class="col-a-wide">
        <p class="eyebrow">Contact us</p>
        <a class="mailbig" href={`mailto:${supportEmail}?subject=Amplifly%20Support`}>{supportEmail}</a>
      </div>
      <div class="col-b-narrow">
        <p class="body">
          Email is the fastest way to reach us. Tell us what's happening and, if it helps, which device
          and app version you're on. We usually reply within 1–2 business days.
        </p>
      </div>
    </div>
  </section>

  <section class="band" data-theme="paper">
    <div class="wrap split">
      <div class="col-a-narrow faq-intro">
        <p class="eyebrow">Common questions</p>
        <h2 class="h2 wipe" style="margin-top:12px">Answers, <em>first.</em></h2>
        <p class="body" style="margin-top:20px">Tap a question to open it. More in the <a class="link" href="/#faq">homepage FAQ</a>.</p>
      </div>
      <div class="col-b-wide faq">
        {topics.map(t => (
          <details>
            <summary>{t.q}<i aria-hidden="true"></i></summary>
            <p>{t.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="band" data-theme="navy">
    <div class="wrap split">
      <div class="col-a-narrow">
        <p class="eyebrow">More resources</p>
        <h2 class="h2 wipe" style="margin-top:12px">Read the details.</h2>
      </div>
      <div class="col-b-wide">
        <ul class="reslist">
          <li><a href="/#faq"><div>Frequently asked questions<span>How the recommender, forecast and timer work</span></div><span class="arrow">→</span></a></li>
          <li><a href="/privacy-policy"><div>Privacy policy<span>What we store and how sync works</span></div><span class="arrow">→</span></a></li>
          <li><a href="/terms-of-service"><div>Terms of service<span>The agreement for using Amplifly</span></div><span class="arrow">→</span></a></li>
          <li><a href="/about"><div>About Amplifly<span>Who's building it, and why</span></div><span class="arrow">→</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
