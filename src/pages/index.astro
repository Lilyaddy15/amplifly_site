---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Wearable from '../components/Wearable.astro';
import BrainStates from '../components/BrainStates.astro';
import Conditions from '../components/Conditions.astro';
import TheManual from '../components/TheManual.astro';
import ForND from '../components/ForND.astro';
import PrivacySection from '../components/PrivacySection.astro';
import FAQ from '../components/FAQ.astro';
import EmailSignup from '../components/EmailSignup.astro';
import Footer from '../components/Footer.astro';
import { faqs } from '../lib/faqs';
import { webPage, faqPage } from '../lib/schema';

const description = 'A flow and strengths app for neurodivergent minds (ADHD, autism, AuDHD and more). Check in with one of five brain states, get matched conditions, log flow sessions, and build a personal operating manual from your own data. On iPhone and Android as Amplifly Lite.';
---

<Layout
  title="Amplifly – Flow & focus app for neurodivergent minds"
  description={description}
  jsonLd={[
    webPage({ path: '/', name: 'Amplifly: a flow and strengths tool for neurodivergent minds', description }),
    faqPage(faqs, '/'),
  ]}
>
  <main>
    <Hero />
    <HowItWorks />
    <BrainStates />
    <Conditions />
    <TheManual />
    <ForND />
    <Wearable />
    <PrivacySection />
    <FAQ />
    <EmailSignup />
  </main>
  <Footer />
</Layout>
