---
import { APP_STORE_URL, APP_STORE_NAME } from '../consts';

const liveToday = [
  'Five brain states, with timestamped check-ins you can update through the day',
  'Twelve built-in conditions across four phases, plus tools you add yourself',
  'An on-device Thompson-sampling recommender that learns from your feedback',
  'Flow Forecast, Focus timer, flow logging, and your operating manual',
  'An account with cross-device sync; works offline once you are signed in',
  'No sensors, no wearables, no biometric data',
];

const inDevelopment = [
  {
    title: 'A wrist-worn optical sensor over Bluetooth',
    desc: 'The BioProxal wearable talks to the phone over Bluetooth LE while the app is open. No background scanning, no location permission.',
  },
  {
    title: 'Every number is computed on the wearable',
    desc: 'The app receives finished values — a flow score, heart rate, HRV, SpO2, breathing rate — and never a raw signal. It only decodes and displays them.',
  },
  {
    title: 'Flow score leads the Today screen',
    desc: 'When connected, the wearable\'s flow score sits at the top of Today, above your brain check-in. Readings are withheld when contact is poor or data goes stale, rather than shown as if they were good.',
  },
  {
    title: 'You label how you feel',
    desc: 'Tap Overwhelmed, Crashing, Focused, or Calm, or log a break. Those labels are sent to the wearable and are what move its baseline from population-level to personalized.',
  },
  {
    title: 'Everything else keeps working',
    desc: 'The wearable is optional — one more signal in the loop. Check-ins, conditions, the recommender, the manual — all of it runs with or without a device connected.',
  },
  {
    title: 'Not in the App Store build',
    desc: 'Nothing wearable-related ships in the app you can download today. Before a wearable-enabled version is released, the privacy policy will be updated to describe exactly what the app does with the wearable\'s numbers.',
  },
];
---
<section class="band" data-theme="navy" id="wearable">
  <div class="wrap">
    <header class="sh">
      <div class="sh__num" aria-hidden="true">06</div>
      <div>
        <p class="eyebrow">What's live, and what's next</p>
        <h2 class="h2 sh__title wipe">{APP_STORE_NAME} is on the App Store today. <em>The BioProxal wearable is what we're building next.</em></h2>
      </div>
    </header>

    <div class="split">
      <div class="col-a-narrow">
        <p class="body">
          The app you can download right now is <strong>{APP_STORE_NAME}</strong>: everything on this
          page, no hardware required. Alongside it, we're partnering with BioProxal, a separate company
          whose wearable is being built specifically for Amplifly, to bring a live physiological signal
          into the same loop. The wearable will be optional.
        </p>
        <p class="body">
          It isn't in the App Store build yet, and we won't say it is until it ships. What's here
          describes how it's built today, not a promise about the final version.
        </p>

        <p class="status" style="margin-top:40px"><i></i>Live today · {APP_STORE_NAME}</p>
        <ul class="checks">
          {liveToday.map(item => (
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>{item}</span></li>
          ))}
        </ul>
        <a class="btn btn--primary" href={APP_STORE_URL} target="_blank" rel="noopener">Get {APP_STORE_NAME} <span class="arrow">→</span></a>
      </div>

      <div class="col-b-wide">
        <p class="status status--dev"><i></i>In development · BioProxal wearable</p>
        <div class="devlist">
          {inDevelopment.map(item => (
            <div><h3>{item.title}</h3><p>{item.desc}</p></div>
          ))}
        </div>
        <p class="small" style="margin-top:24px">
          No release date yet. The privacy policy will describe the wearable data flow before a
          wearable-enabled version ships.
        </p>

        <div class="waitlist" id="wearable-waitlist">
          <p class="eyebrow">Wearable waitlist</p>
          <h3 class="h2" style="font-size:clamp(24px,2.6vw,30px);margin-top:10px">Be first to hear when it ships.</h3>
          <p class="small" style="margin-top:8px">A separate list from app updates. We'll only email it about the wearable.</p>
          <form class="waitlist__form" method="POST" action="/.netlify/functions/wearable-waitlist">
            <div class="field">
              <input type="email" id="wl-email" name="email" required placeholder="you@example.com" autocomplete="email" />
              <label for="wl-email">Your email</label>
            </div>
            <div class="field">
              <input type="text" id="wl-name" name="first_name" placeholder="First name" autocomplete="given-name" />
              <label for="wl-name">First name (optional)</label>
            </div>
            <button class="btn btn--primary" type="submit">Join the waitlist <span class="arrow">→</span></button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
