---
import AppStoreBadge from './AppStoreBadge.astro';
import { APP_STORE_NAME } from '../consts';
import { STATES, glyph } from '../lib/states';

const first = STATES[1]; // Sharp
const tick = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
---
<section class="band hero" data-theme="navy" id="top">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">A flow &amp; strengths tool for neurodivergent minds</p>
      <h1 class="display wipe" style="margin-top:20px">Your brain has five modes. <em>Work with all of them.</em></h1>
      <p class="lead">
        Check in with how your brain feels right now. Get conditions matched to that state.
        Log your sessions, and watch a personal operating manual build itself.
      </p>
      <div class="actions">
        <AppStoreBadge height="h-14" />
        <a class="btn btn--ghost" href="/#loop">See how it works</a>
      </div>
      <p class="small hero__note">
        On the App Store as <strong>{APP_STORE_NAME}</strong>, the software-only release. The BioProxal
        wearable integration is in development. <a class="link" href="/#wearable">What that means</a>
      </p>
      <ul class="ticks">
        <li><Fragment set:html={tick} /> Computed on your device</li>
        <li><Fragment set:html={tick} /> Synced only to your account</li>
        <li><Fragment set:html={tick} /> No analytics or ad tracking</li>
      </ul>
    </div>

    <div id="states">
      <div class="dial" id="dial" data-state={first.id}>
        <div>
          <p class="dial__ask" id="dial-ask">How does your brain feel right now?</p>
          <div class="dial__picker" role="group" aria-labelledby="dial-ask">
            {STATES.map(s => (
              <button class="dial__opt" type="button" data-id={s.id} aria-pressed={String(s.id === first.id)}>
                <Fragment set:html={glyph(s.id, 22)} />{s.label}
              </button>
            ))}
          </div>
        </div>
        <div class="dial__big" id="dial-big" aria-hidden="true"><Fragment set:html={glyph(first.id, 320)} /></div>
        <div style="align-self:end" aria-live="polite">
          <p class="dial__word" id="dial-word"><span>{first.label}.</span></p>
          <p class="dial__desc" id="dial-desc">{first.description}.</p>
        </div>
        <div class="dial__lists">
          <div><h3>Best for</h3><ul class="chips" id="dial-best">{first.bestFor.map(x => <li class="chip">{x}</li>)}</ul></div>
          <div><h3>Protect from</h3><ul class="chips" id="dial-protect">{first.protectFrom.map(x => <li class="chip chip--protect">{x}</li>)}</ul></div>
        </div>
      </div>
      <p class="dial__foot">The five states and their lists, exactly as the app shows them. No wrong answer — update it whenever your brain shifts.</p>
    </div>
  </div>
</section>

<script>
  import { STATES, stateById, glyph } from '../lib/states';
  const dial = document.getElementById('dial');
  const word = document.getElementById('dial-word');
  const desc = document.getElementById('dial-desc');
  const best = document.getElementById('dial-best');
  const protect = document.getElementById('dial-protect');
  const big = document.getElementById('dial-big');
  const chips = (list: string[], cls: string) => list.map(x => `<li class="chip ${cls}">${x}</li>`).join('');

  const select = (id: string) => {
    const s = stateById(id);
    if (!dial || dial.dataset.state === s.id) return;
    dial.dataset.state = s.id;
    dial.querySelectorAll<HTMLButtonElement>('.dial__opt').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.id === s.id)));
    if (word) word.innerHTML = `<span>${s.label}.</span>`;
    if (desc) desc.textContent = s.description + '.';
    if (best) best.innerHTML = chips(s.bestFor, '');
    if (protect) protect.innerHTML = chips(s.protectFrom, 'chip--protect');
    if (big) big.innerHTML = glyph(s.id, 320);
    try { sessionStorage.setItem('amp-state', s.id); } catch {}
    document.dispatchEvent(new CustomEvent('amp:state', { detail: s.id }));
  };

  dial?.addEventListener('click', e => {
    const b = (e.target as Element).closest<HTMLButtonElement>('.dial__opt');
    if (b?.dataset.id) select(b.dataset.id);
  });
  // Arrow keys move between states, like a toolbar.
  dial?.addEventListener('keydown', e => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const i = STATES.findIndex(s => s.id === dial.dataset.state);
    const next = STATES[(i + (e.key === 'ArrowRight' ? 1 : STATES.length - 1)) % STATES.length];
    select(next.id);
    dial.querySelector<HTMLButtonElement>(`[data-id="${next.id}"]`)?.focus();
  });
  try { const saved = sessionStorage.getItem('amp-state'); if (saved) select(saved); } catch {}
</script>
