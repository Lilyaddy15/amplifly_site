---
import { APP_STORE_URL, APP_STORE_NAME } from '../consts';
const year = new Date().getFullYear();
---
<footer class="band foot" data-theme="navy">
  <div class="wrap">
    <p class="foot__word" aria-hidden="true">Amplifly</p>

    <div class="foot__grid">
      <div>
        <p class="body" style="max-width:34ch;color:var(--white)">
          A flow and strengths tool for neurodivergent minds. Understand your patterns. Work with your
          brain. Build your manual.
        </p>
        <p class="small" style="margin-top:16px">Computed on your device. Synced only to your account. No analytics tracking.</p>
        <p class="small" style="margin-top:4px">On the App Store as {APP_STORE_NAME}. BioProxal wearable integration in development.</p>
      </div>
      <nav aria-label="Product">
        <h2>Product</h2>
        <ul>
          <li><a href={APP_STORE_URL} target="_blank" rel="noopener">Download</a></li>
          <li><a href="/#states">Brain states</a></li>
          <li><a href="/#conditions">Conditions</a></li>
          <li><a href="/#manual">Your manual</a></li>
          <li><a href="/#wearable">Wearable</a></li>
          <li><a href="/#email-updates">Email updates</a></li>
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2>Company</h2>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/support">Support</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="mailto:hello@amplifly.me">Contact</a></li>
        </ul>
      </nav>
      <nav aria-label="Legal">
        <h2>Legal</h2>
        <ul>
          <li><a href="/privacy-policy">Privacy policy</a></li>
          <li><a href="/terms-of-service">Terms of service</a></li>
        </ul>
      </nav>
    </div>

    <div class="foot__base">
      <p class="small">© {year} Amplifly. All rights reserved.</p>
      <p class="small">Questions? <a class="link" href="mailto:hello@amplifly.me">hello@amplifly.me</a></p>
    </div>
  </div>
</footer>
