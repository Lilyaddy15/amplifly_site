---
import { APP_STORE_URL } from '../consts';
import { glyph } from '../lib/states';

// Example values only; the row labels are sections the Manual tab really has.
const rows = [
  { k: 'A', label: 'When you flow', value: '4–5 ★ around 2 PM', w: 0 },
  { k: 'B', label: 'Your usual brain', value: `${glyph('sharp', 22)}Sharp · 4 of 12`, w: 33 },
  { k: 'C', label: 'Mornings', value: `${glyph('buzzing', 22)}Buzzing · 3 of 4`, w: 75 },
  { k: 'D', label: 'What gets you in', value: 'Quiet space', w: 64 },
  { k: 'E', label: 'Recommender learned', value: 'Flow Playlist · 80%', w: 80 },
];
const sections = [
  ['When you flow', 'The hour your 4–5 ★ sessions cluster around'],
  ['Through the day', 'Your most common state each morning, midday, afternoon and evening'],
  ['State × flow quality', 'Which brain states produce your best work'],
  ['Gets you in / pulls you out', 'The helpers and drains that keep showing up'],
  ['Recommender learned', 'Conditions ranked by how often they actually helped'],
];
---
<section class="band" data-theme="navy" id="manual">
  <div class="wrap">
    <header class="sh">
      <div class="sh__num" aria-hidden="true">04</div>
      <div>
        <p class="eyebrow">Your operating manual</p>
        <h2 class="h2 sh__title wipe">A living doc, <em>built entirely from your own data.</em></h2>
      </div>
    </header>

    <div class="split">
      <div class="col-a">
        <p class="body">
          Every check-in and flow session teaches Amplifly something. Over time the Manual tab becomes
          the most honest description of how your brain actually works, not how it's supposed to.
        </p>
        <p class="body">
          Patterns appear after a few logged sessions, and the recommender's picks get reliable at
          around 20–30 outcomes. Things that took years to half-notice become visible in weeks.
        </p>
        <ul class="sections">
          {sections.map(([b, t]) => <li><b>{b}</b><span>{t}</span></li>)}
        </ul>
        <div class="actions" style="margin-top:36px">
          <a class="btn btn--primary" href={APP_STORE_URL} target="_blank" rel="noopener">Start building yours <span class="arrow">→</span></a>
        </div>
      </div>

      <div class="col-b">
        <article class="manual" aria-label="Example manual">
          <div class="manual__top"><h3>Your manual</h3><span>Example · last 14 days</span></div>
          {rows.map(r => (
            <div class="manual__row">
              <span class="k">{r.k}</span>
              <span class="l">{r.label}</span>
              <span class="v"><Fragment set:html={r.value} /></span>
              {r.w > 0 && <div class="manual__bar"><i style={`--w:${r.w}%`}></i></div>}
            </div>
          ))}
          <p class="manual__note">Example values. Your manual is built only from what you log.</p>
        </article>
      </div>
    </div>
  </div>
</section>
