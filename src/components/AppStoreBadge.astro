---
import { APP_STORE_URL } from '../consts';

interface Props {
  // Tailwind height utility for the badge, e.g. "h-14". Width scales automatically.
  height?: string;
  class?: string;
}

const { height = 'h-14', class: className = '' } = Astro.props;
---
<a
  href={APP_STORE_URL}
  target="_blank"
  rel="noopener"
  aria-label="Download Amplifly on the App Store"
  class={`inline-block transition-transform hover:scale-[1.03] ${className}`}
>
  <svg
    class={`${height} w-auto`}
    viewBox="0 0 135 40"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-hidden="true"
  >
    <rect width="135" height="40" rx="8" fill="#000" />
    <rect width="135" height="40" rx="8" fill="none" stroke="#A6A6A6" stroke-width="0.5" />
    <!-- Apple logo -->
    <path
      fill="#fff"
      d="M27.3 20.2c0-2.6 2.1-3.9 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9s-2-.9-3.3-.9c-1.7 0-3.3 1-4.1 2.5-1.8 3-.5 7.6 1.3 10.1.9 1.2 1.9 2.6 3.2 2.5 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8 2.2-1.2 3-2.5c1-1.4 1.3-2.8 1.4-2.9-.1 0-2.7-1.1-2.7-4zM24.8 12.6c.7-.9 1.2-2.1 1-3.3-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.2 1.1.1 2.3-.6 3.1-1.5z"
    />
    <!-- Text -->
    <text x="44" y="16" fill="#fff" font-family="Helvetica, Arial, sans-serif" font-size="7">Download on the</text>
    <text x="43.5" y="31" fill="#fff" font-family="Helvetica, Arial, sans-serif" font-size="16" font-weight="600">App Store</text>
  </svg>
</a>
