---
import { APP_STORE_URL } from '../consts';

const links = [
  { href: '/#states', label: 'Brain states' },
  { href: '/#loop', label: 'How it works' },
  { href: '/#conditions', label: 'Conditions' },
  { href: '/#manual', label: 'Your manual' },
  { href: '/#wearable', label: 'Wearable' },
  { href: '/#privacy', label: 'Privacy' },
  { href: '/about', label: 'About' },
];
---
<header class="nav">
  <nav class="nav__bar" aria-label="Main">
    <a class="nav__mark" href="/">
      <img src="/favicon.svg" width="30" height="30" alt="" />
      Amplifly
    </a>

    <div class="nav__links" id="nav-links">
      <span class="nav__pip" id="nav-pip" aria-hidden="true"></span>
      {links.map(l => <a href={l.href} data-section={l.href.startsWith('/#') ? l.href.slice(2) : undefined}>{l.label}</a>)}
    </div>

    <div class="nav__right">
      <a class="btn btn--primary btn--sm" href={APP_STORE_URL} target="_blank" rel="noopener">Get it now</a>
      <button class="nav__toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-panel" aria-label="Open menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="nav__bars" d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div class="nav__panel" id="nav-panel" hidden>
    {links.map(l => <a href={l.href}>{l.label}</a>)}
    <a href="/#email-updates">Email updates</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const bars = toggle?.querySelector('.nav__bars');
  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    bars?.setAttribute('d', open ? 'M6 6l12 12M18 6L6 18' : 'M4 8h16M4 16h16');
  };
  toggle?.addEventListener('click', () => setOpen(panel?.hidden ?? false));
  panel?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });

  // Sliding indicator follows the section in view (homepage) or the current page.
  const linksEl = document.getElementById('nav-links');
  const pip = document.getElementById('nav-pip');
  const anchors = Array.from(linksEl?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
  const place = (a: HTMLAnchorElement | undefined) => {
    if (!pip) return;
    anchors.forEach(x => x.removeAttribute('aria-current'));
    if (!a) { pip.style.opacity = '0'; return; }
    a.setAttribute('aria-current', 'true');
    pip.style.left = a.offsetLeft + 'px';
    pip.style.width = a.offsetWidth + 'px';
    pip.style.opacity = '1';
  };
  if (location.pathname === '/about') place(anchors.find(a => a.getAttribute('href') === '/about'));
  const sections = anchors
    .map(a => ({ a, el: a.dataset.section ? document.getElementById(a.dataset.section) : null }))
    .filter((x): x is { a: HTMLAnchorElement; el: HTMLElement } => !!x.el);
  if (sections.length) {
    const onScroll = () => {
      const y = window.innerHeight * 0.35;
      let current: HTMLAnchorElement | undefined;
      sections.forEach(({ a, el }) => { if (el.getBoundingClientRect().top <= y) current = a; });
      place(current);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();
  }
</script>
