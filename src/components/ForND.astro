---
const profiles = [
  'ADHD', 'Autism', 'AuDHD', 'Dyslexia', 'Dyscalculia',
  'Dyspraxia / DCD', "Tourette's / Tics", 'Sensory Processing',
  'OCD', 'Anxiety', 'Depression', 'PTSD / C-PTSD',
  'Bipolar', 'Twice Exceptional (2e)', 'Other',
];
const withPriors = ['ADHD', 'Autism', 'AuDHD', 'Dyslexia', 'Dyscalculia'];
const principles = [
  { title: 'Not a productivity app', desc: "Amplifly doesn't tell you to do more. It helps you understand how your brain actually works so you can stop fighting it." },
  { title: 'An algorithm that actually learns', desc: 'The on-device recommender is a Thompson-sampling contextual bandit. It starts from research priors and updates every time you give feedback.' },
  { title: 'Different brains, different days', desc: "AuDHD isn't the same as ADHD. A Sharp day isn't the same as a Foggy one. Learning is keyed to your ND profile, brain state and time of day, so it never averages across contexts." },
  { title: 'Starts useful, gets better', desc: 'Research priors make recommendations sensible from day one. Every thumbs up, thumbs down or tagged session adds an observation; after roughly 10–20 outcomes in a given context, your own data dominates.' },
];
---
<section class="band" data-theme="paper" id="for-nd">
  <div class="wrap">
    <header class="sh">
      <div class="sh__num" aria-hidden="true">05</div>
      <div>
        <p class="eyebrow">Built for your wiring</p>
        <h2 class="h2 sh__title wipe">15 ND profiles. Zero judgment. <em>You tell us once.</em></h2>
      </div>
    </header>

    <div class="split">
      <div class="col-a">
        <p class="body">
          Pick the profiles that match your brain, during onboarding or whenever you like. Five of them
          come with research-cited priors that warm up the recommender before you've logged a single
          session. The rest learn purely from your own outcomes, with no invented effect sizes.
        </p>
        <p class="body">You can pick none if you'd rather not say. The recommender still works; it just starts more generic.</p>
        <ul class="chips profiles" style="margin-top:28px">
          {profiles.map(p => <li class={`chip ${withPriors.includes(p) ? 'chip--on' : ''}`}>{p}</li>)}
        </ul>
        <p class="small" style="margin-top:12px">Filled profiles ship with research-cited priors.</p>
      </div>
      <div class="col-b">
        <ol class="principles">
          {principles.map(p => <li><div><h3>{p.title}</h3></div><p>{p.desc}</p></li>)}
        </ol>
      </div>
    </div>
  </div>
</section>
