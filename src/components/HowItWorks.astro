---
const steps = [
  {
    title: 'Check your brain',
    desc: 'Buzzing, Sharp, Flat, Foggy or Scattered. Takes five seconds. Brains shift through the day, so check in again whenever yours does. Each check-in is timestamped.',
    shot: '02-brain-states', alt: 'The Amplifly Today screen asking what kind of brain you have today, with the five states.',
  },
  {
    title: 'Get matched conditions',
    desc: 'Primers, Protectors, Recovery and Resets: twelve built in, plus your own. An on-device recommender ranks them for your brain state, the time of day and your ND profile, then learns from your thumbs up or down and your best sessions.',
    shot: '06-conditions', alt: 'The Conditions tab showing top picks for a Sharp brain.',
  },
  {
    title: 'Log a flow session',
    desc: 'What you worked on, how long, how locked in you were, what helped and what drained you. About 60 seconds. Or run the Focus timer, and when you stop it the log opens with the time already filled in.',
    shot: '05-flow', alt: 'The Flow tab with recent sessions, star ratings, and what helped or drained.',
  },
  {
    title: 'Your manual builds',
    desc: 'After a few sessions the Manual tab fills in: when you flow, your brain through the day, which states produce your best work, what gets you in, what pulls you out, and what the recommender has learned.',
    shot: '03-manual', alt: 'The Manual tab: how you work best, with flow hours, streaks and when you flow.',
  },
];
---
<section class="band" data-theme="paper" id="loop">
  <div class="wrap">
    <header class="sh">
      <div class="sh__num" aria-hidden="true">01</div>
      <div>
        <p class="eyebrow">The loop</p>
        <h2 class="h2 sh__title wipe">Four steps. <em>It runs itself.</em></h2>
      </div>
    </header>

    <div class="loop" id="loop-ui">
      <div>
        <p class="body" style="max-width:52ch;margin-bottom:28px">
          Not another wellness tracker: a tool for spending more hours in your zone. It's a feedback
          loop that gets smarter the more you use it, without extra work from you.
        </p>
        <ol class="loop__steps">
          {steps.map((s, i) => (
            <li class="loop__step" aria-current={i === 0 ? 'step' : undefined}>
              <button type="button" data-i={i} aria-controls={`loop-shot-${i}`}>
                <span class="loop__n">0{i + 1}</span>
                <span class="loop__t">{s.title}</span>
                <span class="loop__d"><span>{s.desc}</span></span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <div class="loop__stage" aria-hidden="false">
        <svg class="loop__ring" viewBox="0 0 100 100" aria-hidden="true">
          <circle class="loop__track" cx="50" cy="50" r="48" />
          <circle class="loop__arc" id="loop-arc" cx="50" cy="50" r="48" pathLength="100" stroke-dasharray="100" stroke-dashoffset="75" />
        </svg>
        <div class="loop__shots">
          {steps.map((s, i) => (
            <img
              id={`loop-shot-${i}`}
              class={i === 0 ? 'is-on' : ''}
              src={`/images/app/${s.shot}-480.webp`}
              srcset={`/images/app/${s.shot}-480.webp 480w, /images/app/${s.shot}-900.webp 900w`}
              sizes="300px" width="1284" height="2778" alt={s.alt}
              loading={i === 0 ? 'eager' : 'lazy'} decoding="async"
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const ui = document.getElementById('loop-ui');
  const arc = document.getElementById('loop-arc');
  const go = (i: number) => {
    ui?.querySelectorAll('.loop__step').forEach((li, j) => j === i ? li.setAttribute('aria-current', 'step') : li.removeAttribute('aria-current'));
    ui?.querySelectorAll('.loop__shots img').forEach((img, j) => img.classList.toggle('is-on', j === i));
    arc?.setAttribute('stroke-dashoffset', String(100 - (i + 1) * 25));
  };
  ui?.addEventListener('click', e => {
    const b = (e.target as Element).closest<HTMLButtonElement>('.loop__step button');
    if (b) go(Number(b.dataset.i));
  });
  ui?.addEventListener('mouseover', e => {
    if (!matchMedia('(hover: hover)').matches) return;
    const b = (e.target as Element).closest<HTMLButtonElement>('.loop__step button');
    if (b) go(Number(b.dataset.i));
  });
</script>
