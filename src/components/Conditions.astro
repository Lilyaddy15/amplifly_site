---
import { APP_STORE_URL } from '../consts';
const phases = [
  {
    id: 'primers',
    label: 'Primers',
    blurb: 'Set up the conditions before you sit down.',
    conditions: [
      { title: 'Box Breathing', label: '4-4-4-4 breath', duration: '2 min', desc: 'Drops your heart rate and clears the static so you can sit down to focused work.' },
      { title: 'Movement Snack', label: '5 min of movement', duration: '5 min', desc: 'Five minutes of any movement before deep work. Drains buzzing energy into a sharper state.' },
      { title: 'One Tab Only', label: 'Close everything else', duration: '1 min', desc: 'Close every tab and app except the one you need. Open tabs are the strongest predictor of context-switching.' },
      { title: 'Flow Playlist', label: 'Same music, every time', duration: 'Ongoing', desc: 'Play the same instrumental playlist every time you do deep work. Over weeks, the music becomes a primer.' },
    ],
  },
  {
    id: 'protectors',
    label: 'Protectors',
    blurb: 'Stay locked in once you arrive.',
    conditions: [
      { title: 'Do Not Disturb + Timer', label: 'Silence + 25 min', duration: '25 min', desc: 'Phone in DND, 25-minute timer, no checking until it ends. The timer turns vague intention into a concrete container.' },
      { title: 'Parking Lot', label: 'Capture, don\'t chase', duration: 'Ongoing', desc: 'When a tangent thought arrives mid-flow, write it on a sheet beside you. The paper holds it so your brain can let go.' },
      { title: 'Body Check', label: 'Water, food, bathroom', duration: '2 min', desc: 'Every 60–90 minutes: are you hydrated, fed, and have you been to the bathroom? Most "I lost focus" moments are unmet body needs.' },
    ],
  },
  {
    id: 'recovery',
    label: 'Recovery',
    blurb: 'Refill the tank between sessions.',
    conditions: [
      { title: 'Flow Debrief', label: '60-second log', duration: '1 min', desc: 'When a session ends, take 60 seconds to log what happened. The data is what builds your operating manual.' },
      { title: 'Horizontal Rest', label: 'Lie flat, 10 min', duration: '10 min', desc: 'Not a nap. Lie flat, no inputs, for 10 minutes. ND brains need real downstate, not just couch-and-phone.' },
    ],
  },
  {
    id: 'resets',
    label: 'Resets',
    blurb: 'Get back to a workable state when scattered.',
    conditions: [
      { title: 'Brain Dump', label: 'Empty your head onto paper', duration: '5 min', desc: 'Set a 5-minute timer and write down every loose thread in your head. The point is the emptying, not the list.' },
      { title: 'One Anchor Task', label: 'Pick one thing', duration: '5–15 min', desc: 'When you can\'t think clearly enough to plan, pick ONE concrete, finishable task and do only that.' },
      { title: '5-4-3-2-1 Grounding', label: 'Use your senses to land', duration: '3 min', desc: 'Five things you see, four you feel, three you hear, two you smell, one you taste. Pulls you out of your head and into the room.' },
    ],
  },
];
---
<section class="band" data-theme="paper" id="conditions">
  <div class="wrap">
    <header class="sh">
      <div class="sh__num" aria-hidden="true">03</div>
      <div>
        <p class="eyebrow">12 built in · 4 phases · plus your own</p>
        <h2 class="h2 sh__title wipe">Not coping mechanisms. <em>Levers you pull on purpose.</em></h2>
      </div>
    </header>

    <div class="split">
      <div class="col-a-narrow">
        <p class="body">
          Each condition is evidence-informed and phase-matched. Amplifly learns which ones work for
          your brain state, time of day and ND profile, then puts those first.
        </p>
        <div class="own">
          <h3>Bring your own, too.</h3>
          <p class="small" style="font-size:16px;line-height:26px">
            Add something you already know works and it joins the list as a first-class option. Mark
            thumbs up or down on any condition, or tag the one you used when you log a session. The
            recommender updates on your device.
          </p>
          <div class="actions" style="margin-top:20px">
            <a class="btn btn--solid" href={APP_STORE_URL} target="_blank" rel="noopener">Get it on the App Store <span class="arrow">→</span></a>
          </div>
        </div>
      </div>

      <div class="col-b-wide">
        <div class="phases" role="tablist" aria-label="Condition phases">
          {phases.map((p, i) => (
            <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1}>{p.label}</button>
          ))}
        </div>
        {phases.map((p, i) => (
          <div role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
            <p class="small phase__blurb"><strong>{p.label}.</strong> {p.blurb}</p>
            <ul class="cond">
              {p.conditions.map(c => (
                <li>
                  <h3>{c.title} <span class="tag">· {c.label}</span></h3>
                  <span class="dur">{c.duration}</span>
                  <p>{c.desc}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#conditions [role="tab"]'));
  const show = (t: HTMLButtonElement) => {
    tabs.forEach(x => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(x.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t));
    t.addEventListener('keydown', e => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      show(next); next.focus();
    });
  });
</script>
