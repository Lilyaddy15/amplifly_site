---
import { PLAY_STORE_URL } from '../consts';

interface Props {
  // Tailwind height utility for the badge, e.g. "h-14". Width scales automatically.
  height?: string;
  class?: string;
}

const { height = 'h-14', class: className = '' } = Astro.props;
---
<a
  href={PLAY_STORE_URL}
  target="_blank"
  rel="noopener"
  aria-label="Get Amplifly on Google Play"
  class={`inline-block transition-transform hover:scale-[1.03] ${className}`}
>
  <svg
    class={`${height} w-auto`}
    viewBox="0 0 135 40"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-hidden="true"
  >
    <rect width="135" height="40" rx="8" fill="#000" />
    <rect width="135" height="40" rx="8" fill="none" stroke="#A6A6A6" stroke-width="0.5" />
    <!-- Google Play logo -->
    <path fill="#4285F4" d="M11 9.4 21.4 20 11 30.6c-.4-.2-.6-.7-.6-1.2V10.6c0-.5.2-1 .6-1.2z" />
    <path fill="#34A853" d="M11 9.4c.4-.2.9-.2 1.4.1l12.4 7.1L21.4 20z" />
    <path fill="#EA4335" d="M11 30.6 21.4 20l3.4 3.4-12.4 7.1c-.5.3-1 .3-1.4.1z" />
    <path fill="#FBBC04" d="m24.8 16.6 3.6 2.1c1 .6 1 2 0 2.6l-3.6 2.1-3.4-3.4z" />
    <!-- Text -->
    <text x="38" y="16" fill="#fff" font-family="Helvetica, Arial, sans-serif" font-size="7">GET IT ON</text>
    <text x="37.5" y="31" fill="#fff" font-family="Helvetica, Arial, sans-serif" font-size="16" font-weight="600" textLength="88" lengthAdjust="spacingAndGlyphs">Google Play</text>
  </svg>
</a>
