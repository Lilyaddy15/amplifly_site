---
import { glyph, stateById } from '../lib/states';

// Example day, in minutes after midnight (7 AM – 10 PM).
const day = [
  ['foggy', 420, 510], ['buzzing', 510, 780], ['sharp', 780, 1020],
  ['flat', 1020, 1170], ['scattered', 1170, 1260], ['foggy', 1260, 1320],
] as const;
const start = 420, span = 900;
---
<section class="band" data-theme="navy" id="through-the-day">
  <div class="wrap">
    <header class="sh">
      <div class="sh__num" aria-hidden="true">02</div>
      <div>
        <p class="eyebrow">Five brain states, one day</p>
        <h2 class="h2 sh__title wipe">Most apps assume your brain works the same all day. <em>Amplifly starts with how it actually feels.</em></h2>
      </div>
    </header>

    <div class="split">
      <div class="col-a-wide">
        <p class="body" style="max-width:56ch;margin-bottom:40px">
          Check in when you wake up, then update your state whenever it changes. Every recommendation
          is filtered through your <em>current</em> state and the time of day, and each check-in is
          timestamped, so your manual learns how you move through a day.
        </p>

        <div class="day" id="day">
          <div class="day__readout" aria-live="polite">
            <span class="day__time" id="day-time">2:00 PM</span>
            <span class="day__now" id="day-now"></span>
          </div>
          <div class="day__track">
            <div class="day__band" id="day-band">
              {day.map(([id, a, b]) => (
                <div class="day__seg" data-s={id} style={`width:${((b - a) / span) * 100}%`}>
                  <Fragment set:html={glyph(id, 18)} />
                  {b - a >= 120 && <span class="lbl">{stateById(id).label}</span>}
                </div>
              ))}
            </div>
            <input class="day__range" id="day-range" type="range" min={start} max={start + span} step="10" value="840" aria-label="Time of day in an example day" />
            <div class="day__head" id="day-head" style="left:46.67%"></div>
          </div>
          <div class="day__ticks" aria-hidden="true"><span>7 AM</span><span>10 AM</span><span>1 PM</span><span>4 PM</span><span>7 PM</span><span>10 PM</span></div>
          <p class="day__hint">An example day. Drag along it to see what the app suggests at each check-in.</p>
        </div>
      </div>

      <div class="col-b-narrow">
        <img class="shot shot--center"
          src="/images/app/04-brain-through-day-480.webp"
          srcset="/images/app/04-brain-through-day-480.webp 480w, /images/app/04-brain-through-day-900.webp 900w"
          sizes="320px" width="1284" height="2778" loading="lazy" decoding="async"
          alt="The Manual tab's 'Your brain through the day' card: your most common state each morning, midday, afternoon and evening." />
      </div>
    </div>
  </div>
</section>

<script>
  import { stateById } from '../lib/states';
  const day = [['foggy', 420, 510], ['buzzing', 510, 780], ['sharp', 780, 1020], ['flat', 1020, 1170], ['scattered', 1170, 1260], ['foggy', 1260, 1320]] as const;
  const range = document.getElementById('day-range') as HTMLInputElement | null;
  const segs = document.querySelectorAll<HTMLElement>('#day-band .day__seg');
  const fmt = (m: number) => {
    const h = Math.floor(m / 60), mm = m % 60, ap = h >= 12 ? 'PM' : 'AM';
    return `${h % 12 || 12}:${mm < 10 ? '0' : ''}${mm} ${ap}`;
  };
  const update = () => {
    if (!range) return;
    const m = Number(range.value);
    let i = 0; while (i < day.length - 1 && m >= day[i][2]) i++;
    const s = stateById(day[i][0]);
    (document.getElementById('day-time') as HTMLElement).textContent = fmt(m);
    (document.getElementById('day-now') as HTMLElement).innerHTML =
      `Checked in <b>${s.label}</b>. Best for ${s.bestFor.slice(0, 2).join(' or ').toLowerCase()}.`;
    (document.getElementById('day-head') as HTMLElement).style.left = ((m - 420) / 900) * 100 + '%';
    range.setAttribute('aria-valuetext', `${fmt(m)}, ${s.label}`);
    segs.forEach((el, j) => el.classList.toggle('is-dim', j !== i));
  };
  range?.addEventListener('input', update);
  update();
</script>
