---
// Long-form reading layout (privacy policy, terms): a sticky contents list built from
// the document's <h2>s, beside the text. Each <section> in the slot needs an id.
---
<section class="band" data-theme="paper">
  <div class="wrap docwrap">
    <nav class="toc" aria-label="On this page">
      <p class="eyebrow">On this page</p>
      <ol id="toc-list"></ol>
    </nav>
    <article class="doc" id="doc">
      <slot />
    </article>
  </div>
</section>

<script>
  const doc = document.getElementById('doc');
  const list = document.getElementById('toc-list');
  const sections = Array.from(doc?.querySelectorAll<HTMLElement>('section[id]') ?? []);
  if (list) {
    list.innerHTML = sections.map(s => {
      const h = s.querySelector('h2');
      return `<li><a href="#${s.id}">${h?.textContent ?? s.id}</a></li>`;
    }).join('');
  }
  const links = Array.from(list?.querySelectorAll('a') ?? []);
  const onScroll = () => {
    let current = 0;
    sections.forEach((s, i) => { if (s.getBoundingClientRect().top < window.innerHeight * 0.3) current = i; });
    links.forEach((a, i) => i === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'));
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
