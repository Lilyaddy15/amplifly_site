---
import { APP_STORE_NAME } from '../consts';

const claims = [
  {
    title: 'Computed on your device.',
    desc: 'The recommender (a Thompson-sampling bandit) and the Flow Forecast (a small neural network) both run on your phone. Nothing you log is sent anywhere to be scored.',
  },
  {
    title: 'Synced only to your account.',
    desc: "Amplifly needs an account. Your check-ins, sessions, profile and recommender state are stored on your phone and synced to your account on Supabase's servers, encrypted in transit, so they're there on your next device. Never sold, never shared.",
  },
  {
    title: 'No analytics. No ads.',
    desc: `We collect no analytics, no crash reports and no advertising data. ${APP_STORE_NAME} uses no sensors, wearables or biometric data, just what you tell it.`,
  },
];
---
<section class="band" data-theme="paper" id="privacy">
  <div class="wrap">
    <header class="sh">
      <div class="sh__num" aria-hidden="true">07</div>
      <div>
        <p class="eyebrow">Privacy by default</p>
        <h2 class="h2 sh__title wipe">Your data belongs to you. <em>All of it.</em></h2>
      </div>
    </header>

    <div class="split">
      <div class="col-a-wide">
        <ul class="claims">
          {claims.map(c => <li><strong>{c.title}</strong><span>{c.desc}</span></li>)}
        </ul>
      </div>
      <div class="col-b-narrow">
        <p class="body">
          Sign out and syncing stops immediately; your local data stays on your phone. To delete your
          account and everything stored under it, email
          <a class="link" href="mailto:hello@amplifly.me">hello@amplifly.me</a>.
        </p>
        <p class="body">
          The BioProxal integration, when it comes, keeps the same rule: readings are computed on the
          wearable, and the app receives only finished numbers. The privacy policy will be updated
          before that version ships.
        </p>
        <p class="body" style="margin-top:28px"><a class="link" href="/privacy-policy">Read the full privacy policy</a></p>
      </div>
    </div>
  </div>
</section>
