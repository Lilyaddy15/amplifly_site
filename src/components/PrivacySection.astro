---
---
<section id="privacy" class="bg-white py-24">
  <div class="container px-6 mx-auto">

    <div class="grid lg:grid-cols-2 gap-16 items-start">

      <!-- Left: headline -->
      <div>
        <p class="text-bright-blue text-sm font-semibold tracking-widest uppercase mb-4">Privacy by default</p>
        <h2 class="text-deep-navy text-3xl md:text-4xl font-bold mb-6">
          Your data belongs to you.<br/>
          <span class="text-bright-blue">All of it. Always.</span>
        </h2>
        <p class="text-accessible-gray text-lg leading-relaxed mb-6">
          Brain check-ins, flow sessions, your ND profile, and the recommendation model all live in
          your device's local storage, and every algorithm runs on the phone. Your account keeps that
          data backed up and available across devices — nothing else touches it.
        </p>
        <p class="text-accessible-gray text-lg leading-relaxed mb-8">
          We collect no analytics, no crash reports, and no advertising data. There is no third-party
          SDK in this app that phones home.
        </p>
        <a href="/privacy-policy" class="text-bright-blue font-semibold hover:text-deep-navy transition-colors text-sm">
          Read the full privacy policy →
        </a>
      </div>

      <!-- Right: detail cards -->
      <div class="space-y-4">
        {[
          {
            icon: '📱',
            title: 'Stored on your device',
            desc: 'Every brain check-in, flow session, ND profile, and learned recommendation posterior is stored in your phone\'s local storage using AsyncStorage. Once you\'re signed in, the app works offline.',
          },
          {
            icon: '☁️',
            title: 'Sync you can read the terms of',
            desc: 'Amplifly needs an account, so your data syncs to it — encrypted in transit and stored on Supabase\'s secure servers solely so it\'s there on your next device. Never sold, never shared.',
          },
          {
            icon: '🤖',
            title: 'On-device AI',
            desc: 'The recommendation engine (Thompson-sampling bandit) and the flow forecast (neural network) both run entirely on your device. No sensors, no wearables — just what you tell it.',
          },
          {
            icon: '🗑️',
            title: 'Delete any time',
            desc: 'Sign out to immediately stop syncing. Your local data stays on your device. To delete your account and all stored data, email hello@amplifly.me.',
          },
        ].map(item => (
          <div class="flex gap-4 p-5 bg-soft-blue rounded-xl">
            <div class="text-2xl flex-shrink-0">{item.icon}</div>
            <div>
              <h3 class="text-deep-navy font-semibold mb-1 text-base">{item.title}</h3>
              <p class="text-accessible-gray text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
