---
import { faqs } from '../lib/faqs';
---
<section class="band" data-theme="navy" id="faq">
  <div class="wrap">
    <div class="split">
      <div class="col-a-narrow faq-intro">
        <p class="eyebrow">Questions</p>
        <h2 class="h2 wipe" style="margin-top:12px">Frequently asked.</h2>
        <p class="body" style="margin-top:20px">
          Something not covered? Email <a class="link" href="mailto:hello@amplifly.me">hello@amplifly.me</a>
          or see <a class="link" href="/support/">Support</a>.
        </p>
      </div>
      <div class="col-b-wide faq">
        {faqs.map(f => (
          <details>
            <summary>{f.q}<i aria-hidden="true"></i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
