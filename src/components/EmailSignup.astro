---
import AppStoreBadge from './AppStoreBadge.astro';
import { APP_STORE_NAME } from '../consts';

const ndProfiles = [
  'ADHD', 'Autism', 'AuDHD', 'Dyslexia', 'Dyscalculia',
  'Dyspraxia / DCD', "Tourette's / Tics", 'Sensory Processing',
  'OCD', 'Anxiety', 'Depression', 'PTSD / C-PTSD',
  'Bipolar', 'Twice Exceptional (2e)', 'Other / Prefer not to say',
];
---
<section class="band" data-theme="blue" id="download">
  <div class="wrap">
    <div class="split">
      <div class="col-a-narrow">
        <p class="eyebrow">Out now</p>
        <h2 class="display wipe" style="margin-top:16px;font-size:clamp(44px,6.4vw,76px)">{APP_STORE_NAME} is on the App Store.</h2>
        <p class="lead" style="margin-top:24px">
          Download it and start building your operating manual today. This is the software-only
          release; the BioProxal wearable integration is still in development.
        </p>
        <div class="actions" style="margin-top:32px"><AppStoreBadge height="h-14" /></div>
      </div>

      <div class="col-b-wide" id="email-updates">
        <h3 class="h2" style="font-size:clamp(26px,3vw,32px)">Want to know when the wearable ships?</h3>
        <p class="body" style="margin:12px 0 36px;max-width:52ch">
          Leave your email and we'll tell you about app updates, the BioProxal wearable integration and
          the Android release.
        </p>

        <form class="signup" method="POST" action="/.netlify/functions/beta-signup">
          <div class="field">
            <input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email" />
            <label for="email">Your email</label>
          </div>
          <div class="field-row">
            <div class="field">
              <input type="text" id="first-name" name="first_name" placeholder="First name" autocomplete="given-name" />
              <label for="first-name">First name (optional)</label>
            </div>
            <div class="field field--static field--select">
              <select id="nd-profile" name="nd_profile">
                <option value="">Choose one</option>
                {ndProfiles.map(p => <option value={p}>{p}</option>)}
              </select>
              <label for="nd-profile">ND profile (optional)</label>
            </div>
          </div>
          <div style="display:grid;gap:12px">
            <label class="opt"><input type="checkbox" name="updates" value="true" /> <span>Send me updates about Amplifly</span></label>
            <label class="opt"><input type="checkbox" name="wearable" value="true" /> <span>Tell me when the BioProxal wearable ships</span></label>
          </div>
          <div class="actions">
            <button class="btn btn--solid" type="submit" style="--ink:var(--deep-navy);--surface:var(--white)">Keep me posted <span class="arrow">→</span></button>
            <p class="small" style="font-size:14px">No spam. No selling your email. Ever.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
