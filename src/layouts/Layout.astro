---
import { baseGraph, SITE_DESCRIPTION } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  noindex?: boolean;      // thank-you pages, 404: keep them out of search results
  jsonLd?: object[];      // page-specific schema.org nodes, added to the shared graph
}

const {
  title,
  description = SITE_DESCRIPTION,
  keywords = "neurodivergent, ADHD, autism, AuDHD, flow state, focus app, executive function, brain states, operating manual, privacy, Amplifly Lite",
  ogImage = "/images/og-image.png",
  ogImageAlt = "Amplifly: a flow and strengths tool for neurodivergent minds",
  canonical,
  noindex = false,
  jsonLd = [],
} = Astro.props;

import Navigation from '../components/Navigation.astro';
import '../styles/amp.css';

// Astro.site comes from astro.config.mjs. Netlify serves pages at /about/ (with the slash), so the
// canonical uses that form too and every page agrees on one URL.
const site = Astro.site ?? new URL('https://amplifly.me');
const pathname = Astro.url.pathname;
const canonicalPath = pathname === '/' ? '/' : pathname.replace(/\/+$/, '') + '/';
const canonicalUrl = canonical ?? new URL(canonicalPath, site).href;

// The homepage sets its own full title; inner pages get the site name appended.
const fullTitle = title.includes('Amplifly') ? title : `${title} — Amplifly`;

// Social cards need an absolute image URL.
const ogImageUrl = new URL(ogImage, site).href;

const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph, ...jsonLd] };
const graphJson = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Amplifly" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Amplifly" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="theme-color" content="#15273F" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Amplifly" />

    <script type="application/ld+json" set:html={graphJson} />

    <link href="https://fonts.cdnfonts.com/css/avenir" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,500;6..12,800;6..12,900&display=swap" rel="stylesheet">

    <script is:inline>document.documentElement.classList.add('js');</script>

    <script>
      document.addEventListener('click', function(e) {
        if (!e.target || !(e.target instanceof Element)) return;
        const link = e.target.closest('a');
        if (link && link.hash && link.origin + link.pathname === window.location.origin + window.location.pathname) {
          e.preventDefault();
          const target = document.querySelector(link.hash);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
            history.pushState(null, '', link.hash);
          }
        }
      });
    </script>
  </head>
  <body class="font-avenir amp">
    <Navigation />
    <slot />
    <script>
      // The one scroll effect: headlines marked .wipe reveal the first time they enter.
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.wipe, .manual').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    background-color: #FFFFFF;
    scroll-behavior: smooth;
  }
  h1 { @apply text-5xl font-bold leading-tight tracking-tight; }
  h2 { @apply text-4xl font-bold leading-tight tracking-tight; }
  p  { @apply text-lg leading-relaxed; }
  .container { @apply max-w-6xl mx-auto; }
  ::selection { @apply bg-bright-blue/20 text-deep-navy; }
</style>
